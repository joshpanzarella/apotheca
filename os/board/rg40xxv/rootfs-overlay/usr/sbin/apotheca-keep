#!/bin/sh
# apotheca-keep NAME PROGRAM [ARGS...]
#
# Runs PROGRAM and starts it again whenever it stops. /etc/inittab runs
# Apotheca under it.
#
#   - A program that ran KEEP_QUICK seconds or more starts again at once.
#   - One that stopped sooner waits 1, 2, 4 ... seconds, at most
#     KEEP_MOST_WAIT, before the next start, so a program that cannot start
#     does not take the CPU.
#   - While the file $KEEP_RUN/NAME.hold exists nothing is started (for work
#     from the shell: touch it, kill the program, do the work, remove it).
#   - Every start and stop is written to $KEEP_LOG/NAME.log.
#   - The program gets KEEP_FAILS: how many starts in a row stopped too soon.
#   - A program that wants the handheld off writes the file $KEEP_RUN/NAME.off
#     (any words: why) before it stops. It is not started again: KEEP_OFF
#     (default: /usr/libexec/apotheca/off, which writes the turn-off in
#     off.log and runs poweroff) is run instead, and this waits to be stopped. The
#     file is deleted before every start, so only the run that wrote it counts;
#     a program that stops without it (a crash, a kill) is started again.
#     Apotheca writes it after saving its song, when quit or left idle
#     (app/power_off.hpp: /usr/libexec/apotheca/run tells it where).
#   - Its own pid is in $KEEP_RUN/NAME.keep.pid (for S95apotheca at shutdown).
#   - Sent TERM or INT (shutdown), it stops the program and then itself.

name=$1
shift
quick=${KEEP_QUICK:-10}
most=${KEEP_MOST_WAIT:-30}
run=${KEEP_RUN:-/run/apotheca}
logdir=${KEEP_LOG:-/data/apotheca/logs}
[ -d "$logdir" ] && [ -w "$logdir" ] || logdir=$run
mkdir -p "$run"
log="$logdir/$name.log"
hold="$run/$name.hold"
off="$run/$name.off"
echo $$ > "$run/$name.keep.pid"

now() { cut -d. -f1 /proc/uptime; }
note() { echo "[$(cut -d' ' -f1 /proc/uptime)] $name: $*" >> "$log"; }

child=
stop() {
    note "told to stop"
    if [ -n "$child" ] && kill "$child" 2>/dev/null; then
        wait "$child"
        note "it stopped with code $?"
    fi
    note "stopped"
    exit 0
}
trap stop TERM INT

fails=0
while :; do
    if [ -e "$hold" ]; then
        note "held ($hold): not started"
        while [ -e "$hold" ]; do sleep 1; done
        note "hold lifted"
        fails=0
    fi
    rm -f "$off"
    began=$(now)
    # The program is told how many times in a row it stopped too soon
    # (/usr/libexec/apotheca/run falls back to drawing with the CPU on 2).
    KEEP_FAILS=$fails "$@" &
    child=$!
    note "started (pid $child)"
    wait "$child"
    code=$?
    child=
    ran=$(( $(now) - began ))
    if [ -f "$off" ]; then
        why=$(head -c 64 "$off" | tr -d '\n')
        note "stopped with code $code after ${ran}s, asking for the handheld off ($why)"
        echo "apotheca-keep: $name asked for the handheld off ($why)" > /dev/console 2>/dev/null
        # With no KEEP_OFF: /usr/libexec/apotheca/off says so in off.log,
        # syncs and runs poweroff, each with a time limit (a plain sync or
        # poweroff here could wait for ever and leave the handheld on).
        if [ -n "$KEEP_OFF" ]; then
            sync
            $KEEP_OFF
        else
            "${KEEP_OFF_SCRIPT:-/usr/libexec/apotheca/off}" apotheca-keep \
                "$name asked, after ${ran}s, code $code ($why)"
        fi
        # Going down: wait here to be stopped (TERM), starting nothing.
        while :; do sleep 60; done
    fi
    if [ "$ran" -lt "$quick" ]; then
        fails=$((fails + 1))
        wait_s=1
        i=1
        while [ "$i" -lt "$fails" ] && [ "$wait_s" -lt "$most" ]; do
            wait_s=$((wait_s * 2)); i=$((i + 1))
        done
        [ "$wait_s" -gt "$most" ] && wait_s=$most
    else
        fails=0
        wait_s=0
    fi
    note "stopped with code $code after ${ran}s; next start in ${wait_s}s"
    sync
    [ "$wait_s" -gt 0 ] && sleep "$wait_s"
done
