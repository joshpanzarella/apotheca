#!/bin/sh
# apotheca-start [ARGS...]: runs Apotheca once, as the port's Apotheca.sh does
# on other firmware, and returns when it stops. apotheca-keep starts it again.
#
# Apotheca keeps everything beside its program (songs, recordings, presets,
# settings, controls.txt, and updates sent over WiFi), so it runs from the
# card's DATA partition, /data/apotheca, not from the read-only system:
#
#   - the system's copy (/usr/lib/apotheca) is put there on the first start,
#     and again whenever the system on the card is newer than the one that
#     put it there (a new card image wins over an earlier WiFi update);
#   - an update accepted on the handheld waits as apotheca.new: it is put in
#     place and the old program kept; if the new one does not get going
#     (the mark update-trying is still there when it stops), twice, the old
#     one comes back. (scripts/Apotheca.sh, the port's, gives it one try.)
#   - a program copied onto the card by hand, over /data/apotheca/apotheca
#     (dist/firmware/apotheca, made by scripts/build-firmware-app.sh), is
#     found by its sum differing from program.md5, the sum of the program
#     this script last put in place. It must be an arm64 program, or it is
#     not run (kept as apotheca.failed); if it is, it is run as an update
#     is, with the system's own program as the one to come back to.
#
# What it did is written to /data/apotheca/logs/apotheca-start.log.
# ARGS default to --handheld. Its output goes to /data/apotheca/apotheca.log.
# A TERM sent to this script is handed on to Apotheca, which then saves its
# song and ends (SDL turns TERM into a quit).

system=/usr/lib/apotheca
dir=/data/apotheca
[ $# -gt 0 ] || set -- --handheld

if ! mountpoint -q /data; then
    echo "apotheca-start: /data is not mounted" >&2
    exit 1
fi
mkdir -p "$dir" || exit 1
cd "$dir" || exit 1
mkdir -p logs
say() { echo "[$(cut -d' ' -f1 /proc/uptime)] program: $*" >> logs/apotheca-start.log; }
sum() { md5sum "$1" 2>/dev/null | cut -d' ' -f1; }
# An arm64 program: ELF, 64-bit, little-endian, machine 0xb7 (AArch64).
arm64() {
    [ "$(od -An -tx1 -N20 "$1" 2>/dev/null | tr -d ' \n')" ] || return 1
    case "$(od -An -tx1 -N20 "$1" | tr -d ' \n')" in
        7f454c460201????????????????????????b700) return 0 ;;
    esac
    return 1
}

if [ ! -x apotheca ] || [ "$(cat system-version 2>/dev/null)" != "$(cat "$system/VERSION")" ]; then
    cp "$system/apotheca" apotheca.part && mv apotheca.part apotheca && chmod +x apotheca
    cp "$system/routed-gothic-narrow.ttf" .
    mkdir -p chords licences
    cp "$system"/chords/*.json chords/
    cp "$system"/licences/* licences/
    cp "$system/VERSION" system-version
    rm -f apotheca.new update-trying update-tries
    sum apotheca > program.md5
    say "the system's program put in place (system $(cat system-version))"
    sync
fi

# The buttons, as the RG40XXV's joypad driver numbers them (os/README.md):
# put there once, so the first start does not ask for each button. Delete
# controls.txt on the card to be asked instead.
# Cards made before 2026-11-17 put X and Y the wrong way round (the owner's
# unit: the device tree's "X" key is the Y button). A controls.txt that is
# still exactly that old default has the two lines swapped; one the player
# made or changed is left alone.
if [ -f controls.txt ] && grep -qx 'X button 2 0 0' controls.txt && grep -qx 'Y button 3 0 0' controls.txt &&
   [ "$(sed -e 's/^X button 2 0 0$/X button 3 0 0/' -e 's/^Y button 3 0 0$/Y button 2 0 0/' controls.txt)" = "$(cat /usr/share/apotheca/controls-rg40xxv.txt)" ]; then
    cp /usr/share/apotheca/controls-rg40xxv.txt controls.txt.part && mv controls.txt.part controls.txt
fi
[ -f controls.txt ] || cp /usr/share/apotheca/controls-rg40xxv.txt controls.txt

# The owner's settings on a new card (2026-11-28: "I change these every single time"): TEXT SIZE small,
# STICK SPEED 100, BRIGHTNESS 100, RING LEVEL 50, the PIANO ROLL at 3 octaves. Put there only when the card has no settings.txt
# yet (a fresh card, or one flashed again); anything set on SET from then on is kept as always. A line
# not in the file is the app's own usual value. The numbers are settings.txt's own (Session::loadSettings:
# "text 0" is SMALL).
[ -f settings.txt ] || cp /usr/share/apotheca/settings-first.txt settings.txt

if [ -f apotheca.new ]; then
    rm -f apotheca.old update-tries
    if mv apotheca apotheca.old && mv apotheca.new apotheca; then
        chmod +x apotheca
        : > update-trying
        sum apotheca > program.md5
        say "an update from WiFi put in place; the one before kept as apotheca.old"
    else
        [ -f apotheca ] || mv apotheca.old apotheca
    fi
    sync
fi

# A program copied onto the card by hand (its sum is not the one put here).
now=$(sum apotheca)
if [ ! -f program.md5 ]; then
    echo "$now" > program.md5          # a card from before this rule: as it is
elif [ "$now" != "$(cat program.md5)" ]; then
    if arm64 apotheca; then
        rm -f apotheca.old update-tries
        cp "$system/apotheca" apotheca.old
        : > update-trying
        echo "$now" > program.md5
        say "a program copied onto the card (md5 $now, $(wc -c < apotheca) bytes): running it; if it does not get going twice, the system's comes back"
    else
        mv apotheca apotheca.failed
        cp "$system/apotheca" apotheca.part && mv apotheca.part apotheca && chmod +x apotheca
        sum apotheca > program.md5
        say "a file copied over the program is not an arm64 program (kept as apotheca.failed): the system's program runs"
    fi
    sync
fi
[ -f update-trying ] || rm -f update-tries

# Run in the background so a TERM (apotheca-keep stopping it, at shutdown)
# can be handed on: Apotheca saves its song on TERM, as when it is quit.
./apotheca "$@" > apotheca.log 2>&1 &
pid=$!
trap 'kill -TERM "$pid" 2>/dev/null' TERM INT HUP
while :; do
    wait "$pid"
    code=$?
    # A signal ends the wait early (code over 128) with the program still there.
    [ "$code" -ne 127 ] && kill -0 "$pid" 2>/dev/null || break
done
trap - TERM INT HUP

# A new program that stops before it said it started fine (the app takes
# update-trying away after 3 s) has two tries; then the one before comes back.
if [ -f update-trying ]; then
    tries=$(( $(cat update-tries 2>/dev/null || echo 0) + 1 ))
    if [ "$tries" -lt 2 ] || [ ! -f apotheca.old ]; then
        echo "$tries" > update-tries
        say "the new program stopped before it got going (code $code, try $tries of 2)"
    else
        rm -f update-trying update-tries
        mv apotheca apotheca.failed
        mv apotheca.old apotheca
        sum apotheca > program.md5
        echo "the new program did not start twice; back to the one before" >> apotheca.log
        say "the new program did not start twice (code $code): kept as apotheca.failed, the one before is back"
        # Not the CPU-drawing fallback for the program that comes back
        # (apotheca-keep counts the failed starts; run reads this).
        : > /run/apotheca/apotheca.rolledback 2>/dev/null
    fi
fi
sync
exit $code
