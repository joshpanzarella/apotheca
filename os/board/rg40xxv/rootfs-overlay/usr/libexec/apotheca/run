#!/bin/sh
# What inittab starts, under apotheca-keep: sets up how Apotheca reaches the
# screen, the sound card and the buttons, then runs it once (apotheca-start).
#
#   screen   SDL's KMSDRM driver (the kernel's display API, no desktop), through
#            Mesa: panfrost on the Mali GPU. If Apotheca has stopped within
#            seconds twice in a row (KEEP_FAILS from apotheca-keep; not when
#            apotheca-start has just put back the program before a new one that
#            did not start, /run/apotheca/apotheca.rolledback), or the file
#            /data/apotheca/gpu-off exists, Mesa draws with the CPU instead
#            (softpipe) and SDL uses its own software renderer: the fallback.
#   sound    ALSA straight to the card: plughw on the first card that is not
#            HDMI (the SoC's codec on the handheld; qemu's virtio card on the
#            desk). /data/apotheca/sound-card overrides it (a card's id).
#   buttons  the joypad is a joystick SDL finds by itself; the volume keys
#            are handed to SDL as a keyboard (there is no udev). The power
#            key is not Apotheca's: apotheca-power has it.
#   off      SEL + START, or nothing to show for idle-off minutes, turns the
#            handheld off: Apotheca saves, writes /run/apotheca/apotheca.off
#            and ends, and apotheca-keep runs poweroff (app/power_off.hpp).
#            The minutes are the "idle-off MINUTES" line of
#            /data/apotheca/power.txt (default 15; 0 never).
#   lights   the screen's backlight and the light ring round the stick are the
#            program's here (nothing else on this system sets them): SET's
#            BRIGHTNESS and STICK LIGHT (app/lights.hpp). APOTHECA_OWNS_SCREEN=1
#            when there is a backlight; APOTHECA_STICK_LIGHT names the serial line
#            of the ring's controller (UART5, 5001400.serial: ttyS2 on our kernel;
#            Linux 7.2 puts the tty's device below the UART's own,
#            .../5001400.serial/5001400.serial:0/5001400.serial:0.0, so both
#            shapes are matched: the first card matched only the other)
#            when that line and the ring's power switch (the LED
#            rgb:kbd_backlight, a GPIO: on or off) are there. Apotheca runs as
#            root, so it can write them. bl_power stays apotheca-power's.

dir=/data/apotheca
log=$dir/logs/apotheca-start.log
mkdir -p "$dir/logs"
say() { echo "[$(cut -d' ' -f1 /proc/uptime)] $*" >> "$log"; }

export SDL_VIDEODRIVER=kmsdrm
export SDL_AUDIODRIVER=alsa
export HOME=/data/apotheca

mode=gpu
fails=${KEEP_FAILS:-0}
# A new program that did not get going was just put back by apotheca-start:
# its failed starts are not this program's (no CPU-drawing fallback for it).
if [ -e /run/apotheca/apotheca.rolledback ]; then
    rm -f /run/apotheca/apotheca.rolledback
    fails=0
fi
if [ -e "$dir/gpu-off" ] || [ "$fails" -ge 2 ]; then
    mode=software
    export LIBGL_ALWAYS_SOFTWARE=1
    export SDL_RENDER_DRIVER=software
fi

# The sound card
card=$(cat "$dir/sound-card" 2>/dev/null)
if [ -z "$card" ]; then
    for c in /proc/asound/card[0-9]*; do
        [ -f "$c/id" ] || continue
        id=$(cat "$c/id")
        case "$id" in *[Hh][Dd][Mm][Ii]*) continue ;; esac
        card=$id
        break
    done
fi
[ -n "$card" ] && export AUDIODEV="plughw:CARD=$card,DEV=0"

# The keys that are keyboards to the kernel: the volume keys (gpio-keys), as
# "2:/dev/input/eventN" (2: a keyboard). Not the power key: apotheca-power's.
keys=
for e in /sys/class/input/event*; do
    name=$(cat "$e/device/name" 2>/dev/null)
    case "$name" in
    *gpio-keys*) keys="${keys:+$keys,}2:/dev/input/$(basename "$e")" ;;
    esac
done
[ -n "$keys" ] && export SDL_EVDEV_DEVICES="$keys"

# Quitting turns the handheld off; so does idling (app/power_off.hpp).
export APOTHECA_OFF_MARK=/run/apotheca/apotheca.off
# The NETWORK row on the SET page: joins a WiFi network through our program
# (firmware plan, section 14). The port sets nothing, and has no row.
[ -x /usr/sbin/apotheca-wifi ] && export APOTHECA_WIFI=/usr/sbin/apotheca-wifi
idle=$(sed -n 's/^idle-off[[:space:]]\{1,\}\([0-9]\{1,4\}\)[[:space:]]*$/\1/p' "$dir/power.txt" 2>/dev/null | tail -n 1)
export APOTHECA_IDLE_OFF_MINUTES=${idle:-15}

# The screen's brightness and the light round the stick (app/lights.hpp).
backlight=none
for b in /sys/class/backlight/*; do
    [ -f "$b/max_brightness" ] && { export APOTHECA_OWNS_SCREEN=1; backlight=${b##*/}; break; }
done
ring=
if [ -e /sys/class/leds/rgb:kbd_backlight/brightness ]; then
    for t in /sys/class/tty/ttyS*; do
        case "$(readlink -f "$t/device" 2>/dev/null)" in
        */5001400.serial|*/5001400.serial/*) [ -c "/dev/${t##*/}" ] && ring=/dev/${t##*/} ;;
        esac
    done
fi
[ -n "$ring" ] && export APOTHECA_STICK_LIGHT=$ring

say "start: $mode drawing, sound ${AUDIODEV:-none found}, keys ${keys:-none}, idle off after ${APOTHECA_IDLE_OFF_MINUTES} min, backlight $backlight, stick light ${ring:-none}, fails before ${KEEP_FAILS:-0}"
exec /usr/sbin/apotheca-start --handheld
