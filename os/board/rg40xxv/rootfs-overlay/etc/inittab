# Apotheca's /etc/inittab, read by BusyBox init (no runlevels, no systemd).
# <tty>::<action>:<program>

# Start the system: mounts, then /etc/init.d/S* in order
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/apotheca
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/sbin/ifconfig lo 127.0.0.1 up
::sysinit:/etc/init.d/rcS

# Apotheca, started again whenever it stops (apotheca-keep backs off one
# that cannot start; touch /run/apotheca/apotheca.hold to stop restarts).
::respawn:/usr/sbin/apotheca-keep apotheca /usr/libexec/apotheca/run

# The power key and the battery (apotheca-power): a short press turns the
# screen off and on, held 2 s turns the handheld off, a low battery too.
# Every way off goes through poweroff, so rcK's S95apotheca saves the song.
::respawn:/usr/sbin/apotheca-power

# A shell on USB serial (the USB-C port), on the board's UART pins, and on
# qemu's serial port for the desk test. Each one starts again when it ends.
# A console whose port is not there sleeps. (Open, with no password, until
# batch 5: owner, 2026-11-17.)
# No shell on the screen (tty1) any more: its "# " prompt sat on the one text
# line below the start-up picture, at start and again at turn-off, and the
# volume keys typed into it while Apotheca ran (the kernel hands them to the
# screen's console as escape codes: VOLUME DOWN is ESC [26~). The handheld
# has no keyboard to use it with (owner, 2026-11-28: nothing on the screen
# but the picture).
::respawn:/usr/libexec/apotheca/console ttyGS0
::respawn:/usr/libexec/apotheca/console ttyS0
::respawn:/usr/libexec/apotheca/console ttyAMA0

# Going down: stop the scripts (S95apotheca first: Apotheca saves and ends),
# then everything written reaches the card and every file system is made
# read-only (off-last: sync, umount -a -r). Each step has a time limit and
# a line in /data/apotheca/logs/off.log (once /data is unmounted, in the
# kernel's log only): /usr/lib/apotheca/off.sh.
::shutdown:/etc/init.d/rcK
::shutdown:/usr/libexec/apotheca/off-last
