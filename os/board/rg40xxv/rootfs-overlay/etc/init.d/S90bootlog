#!/bin/sh
# Writes what this boot found to the card's DATA partition, so the owner can
# send it back: /data/apotheca/logs/boot-NNNN.txt (the newest also as
# boot-latest.txt, and as linux-report.txt on the BOOT partition). A second look 20 s later catches drivers that come late.
# The last 20 boots are kept.

. /usr/lib/apotheca/common.sh

LOGS=/data/apotheca/logs
KEEP=20

section() { echo; echo "===== $1"; }

report() {
    echo "Apotheca boot log"
    section "build"; cat /etc/apotheca-build
    section "kernel"; uname -a; cat /proc/cmdline
    section "device tree"
    tr -d '\0' < /proc/device-tree/model 2>/dev/null; echo
    tr -d '\0' < /proc/device-tree/rocknix-dt-id 2>/dev/null; echo
    section "what U-Boot left on the boot partition (uboot-report.txt)"
    cat "$APOTHECA_RUN/uboot-report.txt" 2>/dev/null
    section "uptime (s) and memory"; cat /proc/uptime; free -k
    section "cpu"
    grep -E '^(processor|BogoMIPS|CPU part)' /proc/cpuinfo
    for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
        [ -d "$c" ] && echo "$c: $(cat $c/scaling_governor 2>/dev/null) $(cat $c/scaling_cur_freq 2>/dev/null) kHz"
    done
    section "apotheca start-up"; cat "$APOTHECA_BOOTLOG" 2>/dev/null
    section "partitions"; cat /proc/partitions; echo; mount
    section "screen (drm, framebuffer, backlight)"
    for s in /sys/class/drm/*/status; do [ -e "$s" ] && echo "$s: $(cat "$s")"; done
    for m in /sys/class/drm/*/modes; do [ -s "$m" ] && echo "$m: $(tr '\n' ' ' < "$m")"; done
    cat /proc/fb 2>/dev/null
    for b in /sys/class/backlight/*; do [ -d "$b" ] && echo "$b: $(cat $b/brightness)/$(cat $b/max_brightness)"; done
    # Which screen: U-Boot read pin PE6 (low: the newer screen) and chose the
    # tree (rocknix-dt-id, at the top). Read again here, straight from the
    # pin controller (port E's data register, bit 6; its function in cfg0).
    if grep -q allwinner /proc/device-tree/compatible 2>/dev/null; then
        pe=$(devmem 0x0300B0A0 32 2>/dev/null) cfg=$(devmem 0x0300B090 32 2>/dev/null)
        [ -n "$pe" ] && echo "screen: PE6 reads $(( (pe >> 6) & 1 )) (port E data $pe, PE6 function $(( (cfg >> 24) & 15 ))); the tree U-Boot chose: $(tr -d '\000' < /proc/device-tree/rocknix-dt-id 2>/dev/null)"
    fi
    section "lights (the LEDs, and the serial lines: the stick's ring is behind UART5, 5001400.serial)"
    for l in /sys/class/leds/*; do
        [ -d "$l" ] || continue
        line="$l: brightness $(cat "$l/brightness" 2>/dev/null) of $(cat "$l/max_brightness" 2>/dev/null)"
        line="$line, trigger [$(sed 's/.*\[\(.*\)\].*/\1/' "$l/trigger" 2>/dev/null)]"
        [ -e "$l/multi_intensity" ] && line="$line, multi_intensity $(cat "$l/multi_intensity") ($(cat "$l/multi_index" 2>/dev/null))"
        echo "$line"
    done
    for t in /sys/class/tty/ttyS*; do
        [ -e "$t/device" ] && echo "${t##*/}: $(readlink -f "$t/device")"
    done
    section "input"; cat /proc/bus/input/devices 2>/dev/null
    section "sound"; cat /proc/asound/cards 2>/dev/null
    for c in /proc/asound/card[0-9]*; do
        [ -d "$c" ] && { echo "--- ${c#/proc/asound/} controls"; amixer -c "${c#/proc/asound/card}" contents 2>&1; }
    done
    section "joysticks as SDL sees them"; /usr/libexec/apotheca/padprobe -l 2>&1
    section "apotheca"
    cat /data/apotheca/logs/apotheca-start.log 2>/dev/null | tail -n 20
    cat /data/apotheca/logs/apotheca.log 2>/dev/null | tail -n 20
    echo "--- apotheca.log (the program's own)"; tail -n 40 /data/apotheca/apotheca.log 2>/dev/null
    section "power"
    for p in /sys/class/power_supply/*; do
        [ -d "$p" ] || continue
        echo "$p:"; cat "$p/uevent" 2>/dev/null | sed 's/^/  /'
    done
    for b in /sys/class/backlight/*; do
        [ -d "$b" ] && echo "backlight $b: brightness $(cat "$b/brightness" 2>/dev/null) of $(cat "$b/max_brightness" 2>/dev/null), bl_power $(cat "$b/bl_power" 2>/dev/null)"
    done
    echo "sleep: state [$(cat /sys/power/state 2>/dev/null)], mem_sleep [$(cat /sys/power/mem_sleep 2>/dev/null)]"
    echo "--- power.log (apotheca-power: the power key, the battery)"; tail -n 30 /data/apotheca/logs/power.log 2>/dev/null
    section "usb"; ls /sys/class/udc 2>/dev/null; cat /sys/kernel/config/usb_gadget/apotheca/UDC 2>/dev/null
    section "regulators"
    for r in /sys/class/regulator/regulator.*; do
        [ -d "$r" ] && echo "$(cat $r/name 2>/dev/null): $(cat $r/microvolts 2>/dev/null) uV $(cat $r/state 2>/dev/null)"
    done
    section "modules"; cat /proc/modules
    section "processes"; ps
    section "dmesg"; dmesg
}

# to_boot FILE: a copy of the log on the card's BOOT partition (the first,
# FAT, the one with README.txt) as linux-report.txt, beside U-Boot's own
# uboot-report.txt: one place to look on a card taken out of a handheld that
# showed nothing, and a log even when DATA could not be made or mounted. The
# partition is mounted only for the copy.
to_boot() {
    root=$(root_partition) || return 1
    boot=$(partition_of "$(disk_of "$root")" 1) || return 1
    mkdir -p "$APOTHECA_RUN/boot"
    mount -t vfat -o rw,noatime "/dev/$boot" "$APOTHECA_RUN/boot" 2>/dev/null || return 1
    cp "$1" "$APOTHECA_RUN/boot/linux-report.txt" 2>/dev/null
    code=$?
    sync
    umount "$APOTHECA_RUN/boot"
    return $code
}

# U-Boot's own report of this start, for the log.
from_boot() {
    root=$(root_partition) || return 1
    boot=$(partition_of "$(disk_of "$root")" 1) || return 1
    mkdir -p "$APOTHECA_RUN/boot"
    mount -t vfat -o ro "/dev/$boot" "$APOTHECA_RUN/boot" 2>/dev/null || return 1
    cp "$APOTHECA_RUN/boot/uboot-report.txt" "$APOTHECA_RUN/uboot-report.txt" 2>/dev/null
    umount "$APOTHECA_RUN/boot"
}

start() {
    from_boot
    if ! mountpoint -q /data; then
        say "boot log: /data is not mounted, the log goes to the boot partition only"
        report > "$APOTHECA_RUN/linux-report.txt" 2>&1
        to_boot "$APOTHECA_RUN/linux-report.txt" && say "boot log: linux-report.txt on the boot partition"
        (
            sleep 20
            { echo; echo "##### 20 seconds later"; report; } >> "$APOTHECA_RUN/linux-report.txt" 2>&1
            to_boot "$APOTHECA_RUN/linux-report.txt"
        ) < /dev/null > /dev/null 2>&1 &
        return 0
    fi
    mkdir -p "$LOGS"
    n=$(cat "$LOGS/count" 2>/dev/null || echo 0)
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    echo "$n" > "$LOGS/count"
    file=$(printf '%s/boot-%04d.txt' "$LOGS" "$n")
    report > "$file" 2>&1
    cp "$file" "$LOGS/boot-latest.txt"
    sync
    say "boot log: $file"
    to_boot "$file" || say "boot log: could not copy it to the boot partition"

    # Keep the last $KEEP
    ls "$LOGS"/boot-[0-9]*.txt 2>/dev/null | sort \
        | awk -v keep=$KEEP '{ f[NR] = $0 } END { for (i = 1; i <= NR - keep; i++) print f[i] }' \
        | xargs -r rm -f

    # A second look once late drivers have come up, and Apotheca has started
    (
        sleep 20
        { echo; echo "##### 20 seconds later"; report; } >> "$file" 2>&1
        cp "$file" "$LOGS/boot-latest.txt"
        sync
        to_boot "$file"
    ) < /dev/null > /dev/null 2>&1 &
}

case "$1" in
    start) start ;;
    stop) sync ;;
    *) echo "usage: $0 start|stop" ;;
esac
