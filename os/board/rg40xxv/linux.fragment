# Apotheca's changes over ROCKNIX's H700 kernel config (linux-rocknix-h700.config).
# Buildroot merges this on top and runs olddefconfig.

CONFIG_LOCALVERSION="-apotheca"
# ROCKNIX fills this in with its own initramfs. Ours is one small program
# (board/rg40xxv/early/init.c, built into the kernel's tree by external.mk):
# it writes the kernel's messages to the card's boot partition, shows the
# stage on the lights, then mounts the root and runs its /sbin/init
# (firmware plan, section 16).
CONFIG_INITRAMFS_SOURCE="apotheca-early/initramfs.list"
# CONFIG_INITRAMFS_PRESERVE_MTIME is not set

# What the kernel said, kept in a piece of memory that a reset does not
# clear (ramoops; the piece is named in every device tree by post-image.sh).
# After a reset U-Boot finds it there and writes it to the card, so a kernel
# that could not reach the card still gets its messages out.
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# The panel's start-up sequence, built in (see external.mk). The WiFi chip's
# firmware is not: it is on the root (linux-firmware), so its driver is a
# module, loaded by S02modules once the root is mounted (section 14).
CONFIG_EXTRA_FIRMWARE="panels/anbernic,rg40xx-panel.panel panels/anbernic,rg40xx-v2-panel.panel panels/anbernic,rg40xx-v2-stock-panel.panel"
CONFIG_EXTRA_FIRMWARE_DIR="firmware-apotheca"

# A serial console over the USB-C port (the device acts as a USB serial
# adapter: ttyGS0 on the device, a COM port or /dev/tty.usbmodem on a computer).
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y

# So the same kernel also boots in qemu's "virt" machine for the desk test
# (os/tools/qemu-test.sh). ROCKNIX's config already has the PL011 serial port
# and virtio-blk; this adds the one missing transport. It never binds on the H700.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# Batch 2's desk test: qemu's virtual screen and sound card, as modules, so
# they load only where qemu's devices are (S02modules) and never on the H700.
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_SND_VIRTIO=m
# Batch 4's desk test: a made-up battery whose level the test sets
# (/sys/module/test_power/parameters), for apotheca-power's low-battery
# turn-off under qemu. A module nothing asks for: never loaded on the H700.
CONFIG_TEST_POWER=m
# The desk test of the panel driver (qemu-test.py): a simulated GPIO chip, for
# a bit-banged SPI bus and two panels that exist only in the test's own
# device tree. A module that loads only where a device tree asks for
# "gpio-simulator": never on the H700.
CONFIG_GPIO_SIM=m

# WiFi (section 14): rtw88 as modules, so the firmware is read from
# /lib/firmware. The 8821CS is the RG40XXV's; the other SDIO parts of the
# family come along for the same price (other H700 handhelds use them).
CONFIG_RTW88=m
CONFIG_RTW88_CORE=m
CONFIG_RTW88_SDIO=m
CONFIG_RTW88_8821C=m
CONFIG_RTW88_8821CS=m
CONFIG_RTW88_8723DS=m
CONFIG_RTW88_8822BS=m
CONFIG_RTW88_8822CS=m
# The desk test's two made-up radios (one the access point); a module never
# loaded on the H700, which has no device to ask for it.
CONFIG_MAC80211_HWSIM=m

# The start-up picture (SHAPETAKER, APOTHECA) in place of the penguins: one,
# not one a core (fbcon=logo-count:1 in extlinux.conf). Copied into the tree
# by external.mk; drawn by os/tools/make-logo.py.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
CONFIG_LOGO_LINUX_CLUT224_FILE="drivers/video/logo/logo_apotheca_clut224.ppm"
