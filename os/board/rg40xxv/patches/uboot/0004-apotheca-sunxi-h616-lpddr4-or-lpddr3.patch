+
+static const struct dram_para para_lpddr3 = {
+	.clk = CONFIG_DRAM_CLK,
+	.type = SUNXI_DRAM_TYPE_LPDDR3,
+	.dx_odt = CONFIG_DRAM_SUNXI_DX_ODT_LPDDR3,
+	.dx_dri = CONFIG_DRAM_SUNXI_DX_DRI_LPDDR3,
+	.ca_dri = CONFIG_DRAM_SUNXI_CA_DRI_LPDDR3,
+	.odt_en = CONFIG_DRAM_SUNXI_ODT_EN_LPDDR3,
+	.tpr0 = CONFIG_DRAM_SUNXI_TPR0,
+	.tpr2 = CONFIG_DRAM_SUNXI_TPR2,
+	.tpr6 = CONFIG_DRAM_SUNXI_TPR6_LPDDR3,
+	.tpr10 = CONFIG_DRAM_SUNXI_TPR10_LPDDR3,
+	.tpr11 = CONFIG_DRAM_SUNXI_TPR11_LPDDR3,
+	.tpr12 = CONFIG_DRAM_SUNXI_TPR12_LPDDR3,
+};
+
+/* Set by mctl_await_completion() when a wait timed out (dram_helpers.c) */
+extern bool mctl_gave_up;
+
+/* The RTC's general purpose register 7: a reset does not clear it. */
+#define DRAM_KIND_MARK	((void *)(SUNXI_RTC_BASE + 0x100 + 7 * 4))
+
+static unsigned int dram_kind_get(unsigned long long place)
+{
+	return readl((void *)(uintptr_t)(CFG_SYS_SDRAM_BASE + place));
+}
+
+static void dram_kind_put(unsigned long long place, unsigned int word)
+{
+	writel(word, (void *)(uintptr_t)(CFG_SYS_SDRAM_BASE + place));
+}
+
+/*
+ * mctl_auto_detect_rank_width(), but a memory that will not train is an
+ * answer here, not a panic.
+ */
+static bool dram_kind_rank_width(const struct dram_para *para,
+				 struct dram_config *config)
+{
+	static const u8 tries[4][2] = { {1, 2}, {1, 1}, {0, 2}, {0, 1} };
+	int i;
+
+	config->cols = 8;
+	config->rows = 13;
+	for (i = 0; i < 4; i++) {
+		config->bus_full_width = tries[i][0];
+		config->ranks = tries[i][1];
+		if (mctl_core_init(para, config))
+			return !mctl_gave_up;
+		if (mctl_gave_up)
+			break;
+	}
+	return false;
+}
+
+static unsigned long dram_kind_try(unsigned int kind)
+{
+	const struct dram_para *para = kind == DRAM_KIND_LPDDR3 ?
+				       &para_lpddr3 : &para_lpddr4;
+	struct dram_config config;
+	unsigned long size;
+
+	/* The memory's rail for this kind, and a moment for it to settle */
+	axp_set_dcdc3(dram_kind_millivolts(kind));
+	mdelay(5);
+
+	/* A wait that timed out is "not this kind", as a refusal is */
+	mctl_gave_up = false;
+	if (!dram_kind_rank_width(para, &config))
+		return 0;
+	mctl_auto_detect_dram_size(para, &config);
+	if (!mctl_core_init(para, &config) || mctl_gave_up)
+		return 0;
+	size = mctl_calc_size(&config);
+	if (!dram_kind_test(size, dram_kind_get, dram_kind_put))
+		return 0;
+	return size;
+}
+
+unsigned long sunxi_dram_init(void)
+{
+	void *const prcm = (void *)SUNXI_PRCM_BASE;
+	const unsigned int first = dram_kind_first(readl(DRAM_KIND_MARK));
+	unsigned int n, kind;
+	unsigned long size;
+
+	setbits_le32(prcm + CCU_PRCM_RES_CAL_CTRL, BIT(8));
+	clrbits_le32(prcm + CCU_PRCM_OHMS240, 0x3f);
+
+	for (n = 0; n < 2; n++) {
+		kind = n ? dram_kind_other(first) : first;
+		/*
+		 * Said before the try: a set-up that never comes back (a
+		 * panic, a time-out: the board resets) leaves this mark, and
+		 * the next run starts with the other kind.
+		 */
+		writel(dram_kind_mark(DRAM_KIND_TRYING, kind), DRAM_KIND_MARK);
+		size = dram_kind_try(kind);
+		if (size) {
+			writel(dram_kind_mark(DRAM_KIND_GOOD, kind), DRAM_KIND_MARK);
+			printf(" LPDDR%u", kind);
+			mctl_set_master_priority();
+			return size;
+		}
+	}
+
+	/* Neither: the other kind first next time, and the caller hangs. */
+	writel(dram_kind_mark(DRAM_KIND_PREFER, dram_kind_other(first)), DRAM_KIND_MARK);
+	return 0;
+};
+#else
 static const struct dram_para para = {
 	.clk = CONFIG_DRAM_CLK,
 #ifdef CONFIG_SUNXI_DRAM_H616_DDR3_1333
@@ -1360,3 +1541,4 @@
 
 	return size;
 };
+#endif
