--- a/arch/arm/mach-sunxi/dram_helpers.c
+++ b/arch/arm/mach-sunxi/dram_helpers.c
@@ -15,13 +15,34 @@
 /*
  * Wait up to 1s for value to be set in given part of reg.
  */
+#ifdef CONFIG_SUNXI_DRAM_H616_LPDDR4_LPDDR3
+/*
+ * A board made with one of two kinds of memory: a wait that times out is an
+ * answer (the wrong kind), not a panic. The wait gives up, says so here, and
+ * every wait after it returns at once, until whoever tries the kinds has
+ * looked and cleared it. (In .data: the SPL's .bss is in the very memory
+ * being set up.)
+ */
+bool mctl_gave_up __section(".data") = false;
+#endif
+
 void mctl_await_completion(u32 *reg, u32 mask, u32 val)
 {
 	unsigned long tmo = timer_get_us() + 1000000;
 
+#ifdef CONFIG_SUNXI_DRAM_H616_LPDDR4_LPDDR3
+	if (mctl_gave_up)
+		return;
+#endif
 	while ((readl(reg) & mask) != val) {
-		if (timer_get_us() > tmo)
+		if (timer_get_us() > tmo) {
+#ifdef CONFIG_SUNXI_DRAM_H616_LPDDR4_LPDDR3
+			mctl_gave_up = true;
+			return;
+#else
 			panic("Timeout initialising DRAM\n");
+#endif
+		}
 	}
 }
 
