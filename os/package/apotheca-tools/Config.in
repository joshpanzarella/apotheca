config BR2_PACKAGE_APOTHECA_TOOLS
	bool "apotheca-tools"
	depends on BR2_PACKAGE_SDL2
	help
	  apotheca-power (/usr/sbin: the power key and the battery,
	  started by inittab), apotheca-splash (the start-up picture
	  with its planet band turning, at start-up and at turn-off;
	  its picture, splash.bin, is made by os/tools/make-logo.py),
	  and two small programs for bring-up and
	  the desk test: padprobe (what SDL sees of the joysticks, in
	  controls.txt's numbers) and fakepad (a uinput stand-in for the
	  RG40XXV's joypad and power key, for qemu). In
	  /usr/libexec/apotheca.
