# Apotheca's own system for the Anbernic RG40XXV (Allwinner H700).
# Built by scripts/build-image.sh. Pinned versions and where each came from:
# docs/plans/firmware-plan.md, "As built: batch 1", and os/board/rg40xxv/README.md.

# The CPU: 4 x Cortex-A53
BR2_aarch64=y
BR2_cortex_a53=y

# Bootlin's prebuilt glibc toolchain (gcc 14), fetched by Buildroot: no gcc build
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y

# Every download is checked against a hash; ours are in the patch folders
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/patches"
BR2_REPRODUCIBLE=y

# The system
BR2_TARGET_GENERIC_HOSTNAME="apotheca"
BR2_TARGET_GENERIC_ISSUE="Apotheca RG40XXV"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/post-image.sh"

# The kernel: Linux 7.2 with ROCKNIX's H700 patches (board/rg40xxv/patches/linux)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/linux-rocknix-h700.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/linux.fragment"
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/dts"
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Trusted Firmware-A (BL31), as ROCKNIX ships it
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="v2.15.0"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"

# U-Boot 2026.01 with ROCKNIX's two patches and its LPDDR4 settings
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic_rg35xx_h700"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="u-boot-sunxi-with-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="SCP=/dev/null"

# The root file system: read-only squashfs, LZ4 (the quickest to unpack)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_TAR is not set

# Programs on the device
# sfdisk and partx grow the data partition on the first boot
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
# mkfs.exfat and exfatlabel for the data partition
BR2_PACKAGE_EXFATPROGS=y
# The buttons and stick (ROCKNIX's driver, a kernel module: os/package/)
BR2_PACKAGE_ROCKNIX_JOYPAD=y
# For bring-up from the shell: press buttons, play a tone
BR2_PACKAGE_EVTEST=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# Batch 2: Apotheca, started at boot (inittab, apotheca-keep), built by this
# toolchain against SDL2 on KMS/DRM (no desktop) with ALSA.
BR2_PACKAGE_APOTHECA=y
BR2_PACKAGE_APOTHECA_TOOLS=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGLES=y
# Mesa: panfrost for the Mali-G31 (with os/patches-to-buildroot, no LLVM on
# the card: its shaders are compiled on the build machine), softpipe as the
# fallback that draws with the CPU, GBM and EGL for SDL's KMSDRM.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Tools that make the image
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_EXFATPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# WiFi (firmware plan, section 14): the 8821CS's firmware from linux-firmware,
# wpa_supplicant to join (WPA2 and WPA3, no D-Bus), avahi so the handheld
# answers as apotheca.local. All started and stopped by /usr/sbin/apotheca-wifi,
# only while the WIFI PAGE is on (their own start-up scripts are taken out in
# post-build.sh). AP_SUPPORT is for the desk test alone: a second made-up
# radio plays the access point there (qemu-test.py).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_APOTHECA_PATH)/board/rg40xxv/busybox.fragment"
